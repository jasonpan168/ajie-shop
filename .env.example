# ---------------------------------------------------------------------------
# 环境变量示例文件
#
# 用法：复制成 .env 并按实际情况填写。
#   cp .env.example .env
#
# ⚠️ .env 已被 .gitignore 排除，请不要提交它：里面是真实数据库口令。
# ⚠️ 也请确保 Web 服务器不会把 .env 当静态文件吐出去（见 .htaccess / nginx 规则）。
#
# 优先级：真实的系统环境变量 > .env 文件 > 代码里的默认值。
# 也就是说，容器里用 -e DB_PASS=xxx 注入的值不会被 .env 覆盖。
# ---------------------------------------------------------------------------

# 数据库
DB_HOST=127.0.0.1
DB_NAME=ajie_shop
DB_USER=root
DB_PASS=

# 易支付（可选；后台「易支付配置」里填了就以数据库为准）
# EPAY_API_URL=https://你的易支付接口地址/
# EPAY_PID=
# EPAY_KEY=
# EPAY_NOTIFY_URL=https://你的域名/notify_url.php
# EPAY_RETURN_URL=https://你的域名/return_url.php
